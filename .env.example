# Copiar a .env.local (ignorado por git) y reiniciar `npm run dev`.
# Opción de prueba "Planes RCG Sis2000": cotiza y emite PLANI / PLANII / PLAN3 por nest-api.

# nest-api de QA (la emisión solo se permite si la URL es de QA o dev).
NEST_API_URL=https://nexusqa.exelixitech.com/nest-api-docs
# Key de nest-api QA con scope del partner patrimonial. Se queda en el servidor de Vite (no va al navegador).
NEST_API_KEY=

# 1 = habilita el botón "Emitir en Sis2000 QA".
VITE_RCG_PLANES_EMITIR=0
VITE_RCG_PLANES_CPRODUCTOR=80080

# Exélixi Nexus (cotizaciones guardadas, búsqueda y pago en línea). Igual que la de nest-api, la key se queda en el
# servidor de Vite (proxy /nexus) y solo se usa para /api/cotizaciones-rc. Sin estas dos, el cotizador sigue con el
# número provisional y avisa.
NEXUS_API_URL=https://nexusqa.exelixitech.com/nexus-api
NEXUS_API_KEY=

# Plan contenedor del ramo 28 para emitir el RCG pagado en línea (QA: PBT1; luego RCGGEN). Vacío = PLANI / PLANII / PLAN3.
VITE_RCG_PLAN_CONTENEDOR=
